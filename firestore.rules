// firestore.rules — Reglas de seguridad de la base de datos (Cloud Firestore), v9.0.
// Se copian y pegan en: Firebase console > Firestore Database > Reglas > Publicar.
// (Ver INSTRUCCIONES-USUARIOS.txt, paso 5.)
//
// Colección "usuarios": un documento por persona, con el mismo identificador (uid) que su cuenta.
//   nombre, email, estado ("pendiente" | "aprobado" | "deshabilitado"), rol ("usuario" | "admin"),
//   creado, ultimoIngreso, actualizado
//
// - Cada persona crea su propio documento al registrarse, siempre como "pendiente" y "usuario".
// - Cada persona puede leer su documento y cambiar solo su nombre y su último ingreso.
// - Un administrador aprobado puede ver a todos y cambiar el estado y el rol de los demás (no el suyo).
// - Nadie puede borrar perfiles desde la página.
//
// Subcolección "usuarios/<uid>/lotes" (v8.3): los "PDF guardados" de cada persona (remitos escaneados) y,
// dentro de cada lote, "partes" con las fotos. Solo la propia persona, con la cuenta aprobada, puede verlos,
// crearlos, cambiarlos y borrarlos. Ni siquiera un administrador ve los lotes de otros.
//
// Subcolección "usuarios/<uid>/unidades" (v9.0): el estado de cada OC + período (tabla confirmada, PDF de remitos en
// Drive, factura cargada, Portal / Mail, fila de la planilla, mail enviado). Mismas condiciones que los lotes.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myProfilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function isAdmin() {
      return signedIn()
        && exists(myProfilePath())
        && get(myProfilePath()).data.rol == 'admin'
        && get(myProfilePath()).data.estado == 'aprobado';
    }
    function validName(n) {
      return n is string && n.size() >= 2 && n.size() <= 80;
    }
    // La propia persona, con la cuenta aprobada.
    function isOwnerApproved(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(myProfilePath())
        && get(myProfilePath()).data.estado == 'aprobado';
    }
    function validLote(d) {
      return d.keys().hasOnly(['creado', 'actualizado', 'paginas', 'partes', 'tamano', 'subido', 'periodo', 'miniatura',
                               'tabla', 'estado', 'enviado', 'carpeta', 'archivo'])
        && d.paginas is int && d.paginas >= 1 && d.paginas <= 300
        && d.estado in ['pendiente', 'lista', 'enviado']
        && d.miniatura is string && d.miniatura.size() <= 200000
        && d.tabla is map;
    }
    function validUnidad(d) {
      return d.keys().hasOnly(['key', 'cliente', 'oc', 'periodo', 'lote', 'confirmacion', 'tablaReal', 'despachos', 'remitos',
                               'pdf', 'factura', 'envio', 'planilla', 'mail', 'wpp', 'sinRemitos', 'creado', 'actualizado'])
        && d.cliente in ['cookmaster', 'grupol']
        && d.oc is string && d.oc.size() >= 1 && d.oc.size() <= 20
        && d.periodo is map
        && d.size() <= 40;
    }
    function validParte(d) {
      return d.keys().hasOnly(['pagina', 'parte', 'de', 'w', 'h', 'datos'])
        && d.pagina is int && d.pagina >= 0 && d.pagina < 300
        && d.parte is int && d.parte >= 0 && d.de is int && d.parte < d.de && d.de <= 20
        && d.datos is bytes && d.datos.size() <= 950000;
    }

    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'estado', 'rol', 'creado', 'ultimoIngreso'])
        && validName(request.resource.data.nombre)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.rol == 'usuario'
        && request.resource.data.creado == request.time;

      allow update: if signedIn() && (
        // la propia persona: solo nombre y último ingreso
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'ultimoIngreso'])
          && validName(request.resource.data.nombre))
        ||
        // un administrador, sobre otra cuenta: estado y rol
        (isAdmin() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'rol', 'actualizado'])
          && request.resource.data.estado in ['pendiente', 'aprobado', 'deshabilitado']
          && request.resource.data.rol in ['usuario', 'admin'])
      );

      allow delete: if false;

      // PDF guardados (lotes de remitos) de esta persona
      match /lotes/{loteId} {
        allow read, delete: if isOwnerApproved(uid);
        allow create, update: if isOwnerApproved(uid) && validLote(request.resource.data);

        match /partes/{parteId} {
          allow read, delete: if isOwnerApproved(uid);
          allow create, update: if isOwnerApproved(uid) && validParte(request.resource.data);
        }
      }

      // Estado de cada OC + período (v9.0)
      match /unidades/{unidadId} {
        allow read, delete: if isOwnerApproved(uid);
        allow create, update: if isOwnerApproved(uid) && validUnidad(request.resource.data);
      }
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
